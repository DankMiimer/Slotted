<?xml version="1.0" encoding="UTF-8"?>
<!--
  Art Book Slot: physical media shelves for GB / GBC / GBA / SNES / NES / N64 / MD / PS1 / PSP / DS / Pico-8.

  Art Book Next is not copied here. It is loaded from where Knulli/Batocera install it, so every
  screen except the cart shelves uses Art Book Next, with its settings and customisations.
  A shared status override puts battery and Wi-Fi at top-left, clock at top-right.
  Root <variables> are parsed before <include>s, which lets ${themePath} point at Art Book Next
  for the lookups it does through that variable. Our own files use ${currentPath} instead.

  The shelves live in the per-system folders (gba/, gb/, gbc/, ...), generated by tools/themebuild.
-->
<theme>
   <formatVersion>7</formatVersion>
   <variables>
      <themePath>/usr/share/emulationstation/themes/es-theme-art-book-next</themePath>
      <slotModelStyle>realistic</slotModelStyle>
      <slotConsoleColor>original</slotConsoleColor>
      <slotSnesCartridgeShelf>snes</slotSnesCartridgeShelf>
   </variables>
   <include>/usr/share/emulationstation/themes/es-theme-art-book-next/theme.xml</include>
   <subset name="slot-gb" displayName="Slot shelf: Game Boy">
      <include name="on" displayName="On"/>
      <include name="off" displayName="Off"/>
   </subset>
   <subset name="slot-gbc" displayName="Slot shelf: Game Boy Color">
      <include name="on" displayName="On"/>
      <include name="off" displayName="Off"/>
   </subset>
   <subset name="slot-gba" displayName="Slot shelf: Game Boy Advance">
      <include name="on" displayName="On"/>
      <include name="off" displayName="Off"/>
   </subset>
   <subset name="slot-snes" displayName="Slot shelf: Super Nintendo">
      <include name="on" displayName="On"/>
      <include name="off" displayName="Off"/>
   </subset>
   <subset name="slot-nes" displayName="Slot shelf: Nintendo NES">
      <include name="on" displayName="On"/>
      <include name="off" displayName="Off"/>
   </subset>
   <subset name="slot-n64" displayName="Slot shelf: Nintendo 64">
      <include name="on" displayName="On"/>
      <include name="off" displayName="Off"/>
   </subset>
   <subset name="slot-megadrive" displayName="Slot shelf: Genesis / Mega Drive">
      <include name="on" displayName="On"/>
      <include name="off" displayName="Off"/>
   </subset>
   <subset name="slot-psx" displayName="Slot shelf: PlayStation">
      <include name="on" displayName="On"/>
      <include name="off" displayName="Off"/>
   </subset>
   <subset name="slot-dreamcast" displayName="Slot shelf: Dreamcast">
      <include name="on" displayName="On"/>
      <include name="off" displayName="Off"/>
   </subset>
   <subset name="slot-psp" displayName="Slot shelf: PSP">
      <include name="on" displayName="On"/>
      <include name="off" displayName="Off"/>
   </subset>
   <subset name="slot-nds" displayName="Slot shelf: Nintendo DS">
      <include name="on" displayName="On"/>
      <include name="off" displayName="Off"/>
   </subset>
   <subset name="slot-pico8" displayName="Slot shelf: Pico-8">
      <include name="on" displayName="On"/>
      <include name="off" displayName="Off"/>
   </subset>
   <subset name="slot-model-style" displayName="Console model style">
      <!-- The independent interaction prototype requires the matching frontend. -->
      <include name="realistic" displayName="Realistic">./_slot/appearance/style-realistic.xml</include>
      <include name="cel" displayName="Cel shaded">./_slot/appearance/style-cel.xml</include>
   </subset>
   <subset name="slot-console-color" displayName="Console color">
      <include name="original" displayName="Original">./_slot/appearance/color-original.xml</include>
      <include name="black" displayName="Black">./_slot/appearance/color-black.xml</include>
      <include name="white" displayName="White">./_slot/appearance/color-white.xml</include>
      <include name="red" displayName="Red">./_slot/appearance/color-red.xml</include>
      <include name="blue" displayName="Blue">./_slot/appearance/color-blue.xml</include>
      <include name="purple" displayName="Purple">./_slot/appearance/color-purple.xml</include>
      <include name="green" displayName="Green">./_slot/appearance/color-green.xml</include>
      <include name="yellow" displayName="Yellow">./_slot/appearance/color-yellow.xml</include>
   </subset>
   <subset name="slot-tv-model" displayName="Slot TV model">
      <!-- Read by the slot frontend; the first entry is the default. -->
      <include name="panasonic" displayName="Panasonic CRT (DamianToons)"/>
      <include name="retro" displayName="Retro TV (Denys Hroshko, non-commercial)"/>
      <include name="pvm" displayName="Sony PVM-1341 (dark_igorek)"/>
      <include name="oldtv" displayName="Old TV, 14-inch (pibanezl)"/>
   </subset>
   <subset name="slot-snes-cartridge-model" displayName="Slot SNES cartridge model">
      <include name="regional" displayName="Regional shell (PAL / US)">./_slot/cartridges/regional.xml</include>
      <include name="tzakol" displayName="Tzakol style (kutejnikov)">./_slot/cartridges/tzakol.xml</include>
   </subset>
   <subset name="slot-gba-sp-model" displayName="Slot GBA SP model">
      <!-- Read by the slot frontend; the first entry is the default. Without the local
           file, or if it fails validation, the NeilVFX choice shows the packaged SP. -->
      <include name="neilvfx" displayName="NeilVFX (local file, if installed)"/>
      <include name="graphicsgeek" displayName="thegraphicsgeek (CC BY)"/>
   </subset>
   <subset name="slot-wallpaper" displayName="Slot wallpaper">
      <include name="off" displayName="Off"/>
      <include name="on" displayName="On"/>
   </subset>
   <subset name="slot-interaction" displayName="Independent slotting (frontend extension)">
      <include name="off" displayName="Off (compatible shelf)"/>
      <include name="on" displayName="On (requires slot frontend)"/>
   </subset>
   <subset name="slot-state" displayName="Slot save-state photo">
      <include name="off" displayName="Off"/>
      <include name="on" displayName="On"/>
   </subset>
   <subset name="slot-video" displayName="Slot cartridge video">
      <include name="on" displayName="On (after 3 seconds)"/>
      <include name="off" displayName="Off"/>
   </subset>
   <include>./_slot/status.xml</include>
</theme>

<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by tools/themebuild (snes): 360x245 carts resting at y=89..334, snes shell. -->
<theme>
   <formatVersion>7</formatVersion>
   <view name="gamecarousel">
      <image name="slot-band" extra="true"><path>contains(upper({game:path}), "(USA") || contains(upper({game:path}), "(CANADA") ? "${currentPath}/band-console-snes-us.png" : "${currentPath}/band-console-snes.png"</path></image>
      <text name="slot-name" extra="true"><visible>false</visible></text>
      <gamecarousel name="gamecarousel">
         <type>horizontal</type>
         <pos>-0.25 0</pos>
         <size>1.5 0.879167</size>
         <color>00000000</color>
         <logoSize>0.26 0.452844</logoSize>
         <logoScale>1.282051</logoScale>
         <logoPos>0.37 0.338626</logoPos>
         <logoAlignment>bottom</logoAlignment>
         <maxLogoCount>3</maxLogoCount>
         <minLogoOpacity>1</minLogoOpacity>
         <transitionSpeed>650</transitionSpeed>
         <defaultTransition>slide</defaultTransition>
         <zIndex>20</zIndex>
         <itemTemplate>
            <image name="backing">
               <autoFade>false</autoFade>
               <path>firstfile(directory({game:path}) + "/media/slotcarts/" + stem({game:path}) + ".back.png", "${currentPath}/backings/snes.png")</path>
            </image>
            <image name="cart">
               <autoFade>false</autoFade>
               <path>firstfile(directory({game:path}) + "/media/slotcarts/" + stem({game:path}) + ".png", "${currentPath}/shells/snes.png")</path>
               <opacity>1</opacity>
               <color>FFFFFFFF</color>
               <storyboard event="activate">
                  <animation property="color" from="FFFFFFFF" to="FFFFFFFF" duration="1"/>
               </storyboard>
               <storyboard event="deactivate">
                  <animation property="color" from="8C8C8CFF" to="8C8C8CFF" duration="1"/>
               </storyboard>
               <storyboard event="scroll">
                  <animation property="color" from="8C8C8CFF" to="8C8C8CFF" duration="1"/>
               </storyboard>
            </image>
            <image name="logo">
               <autoFade>false</autoFade>
               <origin>0.5 0.5</origin>
               <pos>0.5 0.291837</pos>
               <maxSize>0.674667 0.355592</maxSize>
               <path>{game:marquee}</path>
               <visible>!exists(directory({game:path}) + "/media/slotcarts/" + stem({game:path}) + ".png")</visible>
               <opacity>1</opacity>
               <color>FFFFFFFF</color>
               <storyboard event="activate">
                  <animation property="color" from="FFFFFFFF" to="FFFFFFFF" duration="1"/>
               </storyboard>
               <storyboard event="deactivate">
                  <animation property="color" from="8C8C8CFF" to="8C8C8CFF" duration="1"/>
               </storyboard>
               <storyboard event="scroll">
                  <animation property="color" from="8C8C8CFF" to="8C8C8CFF" duration="1"/>
               </storyboard>
            </image>
            <image name="paper">
               <autoFade>false</autoFade>
               <pos>0.116667 0.089796</pos>
               <size>0.766667 0.404082</size>
               <path>${currentPath}/px.png</path>
               <visible>!exists(directory({game:path}) + "/media/slotcarts/" + stem({game:path}) + ".png") &amp;&amp; !exists({game:marquee})</visible>
               <opacity>1</opacity>
               <color>E9E4D8FF</color>
               <storyboard event="activate">
                  <animation property="color" from="E9E4D8FF" to="E9E4D8FF" duration="1"/>
               </storyboard>
               <storyboard event="deactivate">
                  <animation property="color" from="807D77FF" to="807D77FF" duration="1"/>
               </storyboard>
               <storyboard event="scroll">
                  <animation property="color" from="807D77FF" to="807D77FF" duration="1"/>
               </storyboard>
            </image>
            <text name="title">
               <pos>0.162667 0.114041</pos>
               <size>0.674667 0.355592</size>
               <text>{game:nameShort}</text>
               <fontPath>${currentPath}/fonts/OpenSans-SemiBold.ttf</fontPath>
               <fontSize>0.03542</fontSize>
               <fontSize if="${screen.height} &gt;= 720">0.045833</fontSize>
               <alignment>center</alignment>
               <verticalAlignment>center</verticalAlignment>
               <visible>!exists(directory({game:path}) + "/media/slotcarts/" + stem({game:path}) + ".png") &amp;&amp; !exists({game:marquee})</visible>
               <opacity>1</opacity>
               <color>1A1816FF</color>
               <storyboard event="activate">
                  <animation property="color" from="1A1816FF" to="1A1816FF" duration="1"/>
               </storyboard>
               <storyboard event="deactivate">
                  <animation property="color" from="0E0D0CFF" to="0E0D0CFF" duration="1"/>
               </storyboard>
               <storyboard event="scroll">
                  <animation property="color" from="0E0D0CFF" to="0E0D0CFF" duration="1"/>
               </storyboard>
            </text>
         </itemTemplate>
      </gamecarousel>
      <!-- The selected ROM alone plays after resting on the shelf for three seconds.
           Its complete label is replaced with uniformly scaled, cropped video. -->
      <!-- The built-in md_video stays disabled in shelf-common. One persistent
           extra video binds to the cursor. Rebinding enabled resets the delay,
           even when adjacent games share a clip. Keeping it outside animated
           detail containers avoids per-selection player recreation. -->
      <video name="slot_video" extra="true" ifSubset="slot-video:on">
         <path>{game:video}</path>
         <enabled>exists({game:video})</enabled>
         <visible>exists({game:video})</visible>
         <origin>0.5 0.5</origin>
         <pos>0.5 0.440625</pos>
         <minSize>0.5 0.510417</minSize>
         <delay>3</delay>
         <effect>none</effect>
         <audio>false</audio>
         <showSnapshotDelay>false</showSnapshotDelay>
         <showSnapshotNoVideo>false</showSnapshotNoVideo>
         <zIndex>22</zIndex>
         <saturation>exists(directory({game:path}) + "/media/slotcarts/" + stem({game:path}) + ".slot-profile-snes-us") ? 0.75 : 1</saturation>
         <shader>
            <path>${currentPath}/shaders/media.glsl</path>
            <mediaMode>0</mediaMode>
            <mediaSize>360 245</mediaSize>
            <mediaWell0>0.116666667 0.0897959184 0.766666667 0.404081633</mediaWell0>
            <mediaCorner0>0</mediaCorner0>
            <mediaWell1>0.194444444 0.0285714286 0.611111111 0.424489796</mediaWell1>
            <mediaCorner1>10</mediaCorner1>
         </shader>
      </video>
   </view>
</theme>
